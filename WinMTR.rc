IDR_MAINFRAME           ICON                    "WinMTR.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_WINMTR_DIALOG DIALOGEX 0, 0, 590, 236
STYLE DS_SETFONT | DS_3DLOOK | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "DiamondHost 網路路由診斷工具"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x1
BEGIN
    LTEXT           "主機：",IDC_STATIC,15,14,28,13,SS_CENTERIMAGE
    COMBOBOX        IDC_COMBO_HOST,45,11,205,82,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "開始",ID_RESTART,255,11,45,16,BS_FLAT
    GROUPBOX        "目標主機",IDC_STATIC,7,3,300,30,BS_FLAT
    PUSHBUTTON      "選項",ID_OPTIONS,320,11,45,16,BS_FLAT
    PUSHBUTTON      "重新統計",ID_RESET_STATS,369,11,56,16,BS_FLAT
    PUSHBUTTON      "截圖到剪貼簿",ID_SCREENSHOT,429,11,76,16,BS_FLAT
    PUSHBUTTON      "離開",IDCANCEL,530,11,47,16,BS_FLAT
    GROUPBOX        "主要操作",IDC_STATICS,312,3,271,30,BS_FLAT
    LTEXT           "IP：正在取得…",IDC_INFO_IP,14,45,112,10
    LTEXT           "國家：—",IDC_INFO_COUNTRY,132,45,90,10
    LTEXT           "城市：—",IDC_INFO_CITY,228,45,90,10
    LTEXT           "ASN：—",IDC_INFO_ASN,324,45,76,10
    LTEXT           "Hostname：—",IDC_INFO_HOSTNAME,14,62,210,10
    LTEXT           "ISP：—",IDC_INFO_ISP,230,62,340,10
    GROUPBOX        "目前網路資訊",IDC_STATICJ,7,34,576,46,BS_FLAT
    CONTROL         "路由追蹤結果",IDC_LIST_MTR,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,85,576,144
END

IDD_DIALOG_OPTIONS DIALOGEX 0, 0, 251, 188
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "選項"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,53,167,50,14,BS_FLAT
    PUSHBUTTON      "取消",IDCANCEL,141,167,50,14,BS_FLAT
    GROUPBOX        "",IDC_STATIC,7,91,237,67,BS_FLAT
    ICON            IDR_MAINFRAME,IDC_STATIC,15,12,20,20
    LTEXT           "間隔（秒）：",IDC_STATIC,15,102,55,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_INTERVAL,71,99,34,13,ES_AUTOHSCROLL
    LTEXT           "封包大小（位元組）：",IDC_STATIC,126,102,72,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_SIZE,196,99,34,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "解析主機名稱",IDC_CHECK_DNS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,157,119,73,10
    GROUPBOX        "",IDC_STATIC,7,7,237,82,BS_FLAT
    CTEXT           "DiamondHost WinMTR－依 GPL V2 授權",IDC_STATIC,42,14,194,17
    PUSHBUTTON      "授權與製作資訊",ID_LICENSE,81,67,94,14,BS_FLAT
    LTEXT           "歷史主機數量上限：",IDC_STATIC,15,119,74,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_MAX_LRU,90,116,34,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "使用 IPv4",IDC_IPV4_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,141,55,10
    CONTROL         "使用 IPv6",IDC_USEIPV6_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,159,139,55,10
END

IDD_DIALOG_LICENSE DIALOGEX 0, 0, 175, 70
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "授權與製作資訊"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,59,43,50,14
    LTEXT           "詳細資訊：",IDC_STATIC,36,27,46,8
    CONTROL         "Github",IDC_MFCLINK1,"MfcLink",WS_TABSTOP,83,26,60,14
    LTEXT           "DiamondHost WinMTR 依 GPL V2 授權。",IDC_STATIC,27,14,125,8
END

IDD_DIALOG_HELP DIALOGEX 0, 0, 256, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DiamondHost WinMTR 說明"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,144,101,50,14
    LTEXT           "DiamondHost WinMTR 依 GPL V2 授權",IDC_STATIC,7,9,176,10
    LTEXT           "用法：WinMTR [選項] 目標主機名稱",IDC_STATIC,7,29,170,8
    LTEXT           "選項：",IDC_STATIC,7,39,28,8
    LTEXT           "     --interval, -i 數值：設定探測間隔。",IDC_STATIC,26,47,170,8
    LTEXT           "     --size, -s 數值：設定封包大小。",IDC_STATIC,26,57,160,8
    LTEXT           "     --maxLRU, -m 數值：設定歷史主機上限。",IDC_STATIC,26,67,185,8
    LTEXT           "     --help, -h：顯示說明。",IDC_STATIC,26,89,130,8
    LTEXT           "     --numeric, -n：不解析主機名稱。",IDC_STATIC,26,78,165,8
END


