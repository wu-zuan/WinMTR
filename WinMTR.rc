IDR_MAINFRAME           ICON                    "WinMTR.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_WINMTR_DIALOG DIALOGEX 0, 0, 590, 236
STYLE DS_SETFONT | DS_3DLOOK | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "DiamondHost 網路路由診斷工具"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x1
BEGIN
    LTEXT           "主機：",IDC_STATIC,15,14,28,13,SS_CENTERIMAGE
    COMBOBOX        IDC_COMBO_HOST,45,11,205,82,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "開始",ID_RESTART,255,11,45,16,BS_FLAT
    GROUPBOX        "目標主機",IDC_STATIC,7,3,300,30,BS_FLAT
    PUSHBUTTON      "選項",ID_OPTIONS,320,11,45,16,BS_FLAT
    PUSHBUTTON      "重新統計",ID_RESET_STATS,369,11,56,16,BS_FLAT
    PUSHBUTTON      "截圖到剪貼簿",ID_SCREENSHOT,429,11,76,16,BS_FLAT
    PUSHBUTTON      "離開",IDCANCEL,530,11,47,16,BS_FLAT
    GROUPBOX        "主要操作",IDC_STATICS,312,3,271,30,BS_FLAT
    LTEXT           "IP：正在取得…",IDC_INFO_IP,14,45,112,10
    LTEXT           "國家：—",IDC_INFO_COUNTRY,132,45,90,10
    LTEXT           "城市：—",IDC_INFO_CITY,228,45,90,10
    LTEXT           "ASN：—",IDC_INFO_ASN,324,45,76,10
    LTEXT           "Hostname：—",IDC_INFO_HOSTNAME,14,62,210,10
    LTEXT           "ISP：—",IDC_INFO_ISP,230,62,340,10
    GROUPBOX        "目前網路資訊",IDC_STATICJ,7,34,576,46,BS_FLAT
    CONTROL         "路由追蹤結果",IDC_LIST_MTR,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,85,576,144
END

IDD_DIALOG_OPTIONS DIALOGEX 0, 0, 251, 248
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "選項"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,53,227,50,14,BS_FLAT
    PUSHBUTTON      "取消",IDCANCEL,141,227,50,14,BS_FLAT
    GROUPBOX        "追蹤與顯示設定",IDC_STATIC,7,91,237,128,BS_FLAT
    LTEXT           "間隔（秒）：",IDC_STATIC,15,102,55,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_INTERVAL,71,99,34,13,ES_AUTOHSCROLL
    LTEXT           "封包大小（位元組）：",IDC_STATIC,126,102,72,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_SIZE,196,99,34,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "解析主機名稱",IDC_CHECK_DNS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,145,141,79,10
    GROUPBOX        "關於",IDC_STATIC,7,7,237,76,BS_FLAT
    LTEXT           "DiamondHost WinMTR",IDC_STATIC,18,21,130,12
    LTEXT           "基於 WinMTR-refresh 修改｜GNU GPL v2",IDC_STATIC,18,39,210,10
    PUSHBUTTON      "查看授權與專案資訊",ID_LICENSE,18,58,112,14,BS_FLAT
    LTEXT           "歷史主機上限：",IDC_STATIC,15,142,64,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_MAX_LRU,80,139,34,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "最大跳數：",IDC_STATIC,15,122,45,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_MAX_HOPS,61,119,34,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "每跳路徑數：",IDC_STATIC,126,122,55,10,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_MAX_PATHS,182,119,34,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "使用 IPv4",IDC_IPV4_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,161,55,10
    CONTROL         "使用 IPv6",IDC_USEIPV6_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,159,161,55,10
    CONTROL         "高度隨內容調整",IDC_CHECK_AUTO_HEIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,181,78,10
    CONTROL         "主機名稱後顯示 IP",IDC_CHECK_SHOW_IP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,126,181,101,10
    CONTROL         "查詢 IP 國家、ASN 與 ISP 資訊",IDC_CHECK_NETWORK_INFO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,201,151,10
END

IDD_DIALOG_LICENSE DIALOGEX 0, 0, 360, 188
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "關於 DiamondHost WinMTR"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x0
BEGIN
    CONTROL         "",IDC_LICENSE_HEADER,"Static",SS_LEFT | WS_GROUP,0,0,360,44
    LTEXT           "<>  DiamondHost WinMTR",IDC_LICENSE_HEADER_TITLE,18,9,250,14
    LTEXT           "開放原始碼網路診斷工具",IDC_LICENSE_HEADER_SUBTITLE,31,27,220,10
    LTEXT           "本程式基於 WinMTR-refresh 修改，並依 GNU GPL v2 授權。",IDC_LICENSE_INTRO,18,55,324,12
    CONTROL         "",IDC_LICENSE_PROJECT_CARD,"Static",SS_OWNERDRAW,16,74,328,39
    LTEXT           "DiamondHost 專案",IDC_LICENSE_PROJECT_CAPTION,27,81,88,10
    CONTROL         "wu-zuan / winmtr",IDC_MFCLINK1,"Button",BS_OWNERDRAW | BS_FLAT | WS_TABSTOP,27,94,220,14
    CONTROL         "",IDC_LICENSE_UPSTREAM_CARD,"Static",SS_OWNERDRAW,16,119,328,39
    LTEXT           "原始上游專案",IDC_LICENSE_UPSTREAM_CAPTION,27,126,88,10
    CONTROL         "leeter / WinMTR-refresh",IDC_MFCLINK_UPSTREAM,"Button",BS_OWNERDRAW | BS_FLAT | WS_TABSTOP,27,139,240,14
    LTEXT           "在 GitHub 查看原始碼、版本紀錄與問題回報",IDC_LICENSE_FOOTER,18,168,220,10
    CONTROL         "完成",IDOK,"Button",BS_OWNERDRAW | BS_DEFPUSHBUTTON | WS_TABSTOP,292,165,52,16
END

IDD_DIALOG_HELP DIALOGEX 0, 0, 256, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DiamondHost WinMTR 說明"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,144,101,50,14
    LTEXT           "DiamondHost WinMTR 依 GPL V2 授權",IDC_STATIC,7,9,176,10
    LTEXT           "用法：WinMTR [選項] 目標主機名稱",IDC_STATIC,7,29,170,8
    LTEXT           "選項：",IDC_STATIC,7,39,28,8
    LTEXT           "     --interval, -i 數值：設定探測間隔。",IDC_STATIC,26,47,170,8
    LTEXT           "     --size, -s 數值：設定封包大小。",IDC_STATIC,26,57,160,8
    LTEXT           "     --maxLRU, -m 數值：設定歷史主機上限。",IDC_STATIC,26,67,185,8
    LTEXT           "     --help, -h：顯示說明。",IDC_STATIC,26,89,130,8
    LTEXT           "     --numeric, -n：不解析主機名稱。",IDC_STATIC,26,78,165,8
END


